reports/timing/*
!reports/timing/*.md
!reports/deploys/
reports/deploys/*
!reports/deploys/*.md
!reports/external-validation/
reports/external-validation/*
!reports/external-validation/*.md
!reports/audits/
reports/audits/*
!reports/audits/*.md
!reports/trivy/
reports/trivy/*
!reports/trivy/*.md
