# Rust build artifacts
/target/
/target-*/
# Cargo.lock IS tracked — pqcd is a binary/application workspace; a committed
# lockfile is required for reproducible, audited builds (and for CI to resolve
# the exact dependency versions the code was written against).

# Agent tooling (local only, not tracked)
.claude/

# Editor and OS artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local environment
.env
.env.local

# Test and devnet artifacts
/snapshots/
/devnet-data/
*.rocksdb/
*.log

# Research source inputs (not committed)

# Ansible inventory — contains real IPs and credentials
deploy/ansible/inventory/hosts.yml
deploy/ansible/inventory/hosts.ini
deploy/ansible/group_vars/all/mainnet_keys.yml

# Python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.egg-info/
sdk/python/dist/
sdk/python/build/

# Node.js artifacts
sdk/typescript/node_modules/
sdk/typescript/dist/
sdk/typescript/package-lock.json

