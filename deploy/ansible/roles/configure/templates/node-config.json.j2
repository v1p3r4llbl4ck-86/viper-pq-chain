{
  "_comment": "Viper PQ Chain node config — generated by Ansible on {{ ansible_date_time.iso8601 }}. Do not edit by hand.",
  "node_id": "{{ viper_node_id }}",
  "chain_id_hex": "{{ viper_chain_id_hex }}",
  "data_dir": "{{ viper_data_dir }}/{{ viper_node_id }}",
  "anchor_prev_hash_hex": "{{ viper_anchor_prev_hash_hex }}",
  "fee_params": {
    "base_fee":          {{ viper_fee_params.base_fee }},
    "byte_fee":          {{ viper_fee_params.byte_fee }},
    "sigverify_fee_v_a": {{ viper_fee_params.sigverify_fee_v_a }},
    "sigverify_fee_v_b": {{ viper_fee_params.sigverify_fee_v_b }},
    "sigverify_fee_v_c": {{ viper_fee_params.sigverify_fee_v_c }},
    "exec_fee_per_gas":  {{ viper_fee_params.exec_fee_per_gas }}
  },
  "p2p_listen_addr": "0.0.0.0:{{ viper_p2p_port }}",
{% if viper_role == 'validator' %}
  "api_listen_addr": "0.0.0.0:{{ viper_api_port | default(26657) }}",
{% else %}
  "api_listen_addr": "127.0.0.1:{{ viper_api_port | default(26657) }}",
{% endif %}
  "peers": [
{% if viper_role == 'full' %}
    {
      "node_id": "{{ viper_upstream_node_id | trim }}",
      "p2p_addr": "{{ viper_upstream_p2p_addr | trim }}"
    }
{% endif %}
  ],
  "devnet": {
    "role": "{{ viper_role }}",
    "sync_interval_ms": {{ viper_sync_interval_ms }},
    "block_time_ms":    {{ viper_block_time_ms }},
{% if viper_role == 'validator' %}
    "proposer_address_hex": "{{ viper_proposer_address_hex }}",
{% endif %}
    "epoch_duration":   {{ viper_epoch_duration }},
    "unbonding_period": {{ viper_unbonding_period }},
    "validators": [
{% for v in viper_validators %}
      {# SECURITY-FIX-PLAN.md §1 — `commit_seed_hex` no longer rendered into node.json.
         Validator commit seeds live in the air-gapped keystore.json shipped at 0600
         to each host (see `viper_keystore_path` below); pqcd loads them via
         `Keystore::load_from_file` and refuses to start if a stale seed in node.json
         disagrees with the keystore copy. Compromise of /etc/pqchain/node.json now
         exposes no signing material. #}
      {
        "node_id":         "{{ v.node_id }}",
        "address_hex":     "{{ v.address_hex }}",
        "sig_alg_id":      {{ v.sig_alg_id }},
        "public_key_hex":  "{{ v.public_key_hex }}"
      }{% if not loop.last %},{% endif %}

{% endfor %}
    ]{% if viper_keystore_path is defined %},
    "keystore_path": "{{ viper_keystore_path }}"
{% endif %}

  },
  "genesis_accounts": [
{% for acct in viper_genesis_accounts %}
    {
      "address_hex": "{{ acct.address_hex }}",
      "balance":     {{ acct.balance }},
      "nonce":       {{ acct.nonce }},
      "keys": [
{% for k in acct['keys'] %}
        {
          "alg_id":           {{ k.alg_id }},
          "pk_hex":           "{{ k.pk_hex }}",
          "key_version":      {{ k.key_version }},
          "valid_from_height": {{ k.valid_from_height }},
          "status":           "{{ k.status }}",
          "allowed_tx_types": {{ k.allowed_tx_types }}
        }{% if not loop.last %},{% endif %}

{% endfor %}
      ]
    }{% if not loop.last %},{% endif %}

{% endfor %}
  ],
  "rate_limit": {
    "max_requests_per_window": {{ viper_rate_limit.max_requests_per_window }},
    "window_secs":             {{ viper_rate_limit.window_secs }}
  },
  "sender_budget": {
    "max_admits_per_window": {{ viper_sender_budget.max_admits_per_window }},
    "window_secs":           {{ viper_sender_budget.window_secs }}
  }{% if viper_libp2p is defined %},
  "libp2p": {
    "enable": {{ viper_libp2p.enable | default(false) | lower }}{% if viper_libp2p.validator_listen is defined %},
    "validator_listen": "{{ viper_libp2p.validator_listen }}"{% endif %}{% if viper_libp2p.vfn_listen is defined %},
    "vfn_listen": "{{ viper_libp2p.vfn_listen }}"{% endif %}{% if viper_libp2p.public_listen is defined %},
    "public_listen": "{{ viper_libp2p.public_listen }}"{% endif %}{% if viper_libp2p.bootstrap_peers is defined %},
    "bootstrap_peers": {{ viper_libp2p.bootstrap_peers | to_json }}{% endif %}{% if viper_libp2p.gossip_mesh_n is defined %},
    "gossip_mesh_n": {{ viper_libp2p.gossip_mesh_n }}{% endif %}{% if viper_libp2p.gossip_mesh_n_low is defined %},
    "gossip_mesh_n_low": {{ viper_libp2p.gossip_mesh_n_low }}{% endif %}{% if viper_libp2p.gossip_mesh_n_high is defined %},
    "gossip_mesh_n_high": {{ viper_libp2p.gossip_mesh_n_high }}{% endif %}{% if viper_libp2p.quic_enabled is defined %},
    "quic_enabled": {{ viper_libp2p.quic_enabled | lower }}{% endif %}{% if viper_libp2p.tcp_tls_fallback is defined %},
    "tcp_tls_fallback": {{ viper_libp2p.tcp_tls_fallback | lower }}{% endif %}{% if viper_libp2p.max_peers_per_asn is defined %},
    "max_peers_per_asn": {{ viper_libp2p.max_peers_per_asn }}{% endif %}{% if viper_libp2p.validator_peer_ids is defined %},
    "validator_peer_ids": {{ viper_libp2p.validator_peer_ids | to_json }}{% endif %}

  }{% endif %}

}
