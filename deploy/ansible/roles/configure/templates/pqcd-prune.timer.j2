[Unit]
Description=Viper PQ Chain — weekly full node disk reclamation tick (TASK-187a)
Documentation=file://{{ viper_repo_path | default('/opt/viper-pq-chain') }}/docs/operators/RUNBOOK.md

[Timer]
# Weekly Sunday at 03:00 UTC — well outside business hours for both the
# EU operator (CET 04:00 / 05:00 with DST) and the validator soak window.
# Persistent=true catches up after extended downtime so a long power cut
# doesn't cause skipped prune cycles to accumulate to disk pressure.
OnCalendar=Sun *-*-* 03:00:00 UTC
RandomizedDelaySec=15min
Persistent=true
AccuracySec=1min
Unit=pqcd-prune.service

[Install]
WantedBy=timers.target
