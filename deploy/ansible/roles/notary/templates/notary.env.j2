# Viper Notary environment — generated by Ansible on {{ ansible_date_time.iso8601 }}.
# File is owned by pqchain:pqchain, mode 0640. Do not edit by hand.
#
# SECURITY: NOTARY_SEED_HEX is the ML-DSA-65 signing credential for the Notary
# service account. In production, inject this from a secrets manager
# (AWS Secrets Manager, HashiCorp Vault, etc.) rather than storing it here.
# For devnet, the value is taken from group_vars/validators.yml.

NOTARY_LISTEN_ADDR=0.0.0.0:{{ notary_port }}
NOTARY_NODE_URL=http://127.0.0.1:{{ viper_api_port }}
NOTARY_SEED_HEX={{ notary_service_account_seed_hex }}
NOTARY_ADDRESS_HEX={{ notary_service_account_address_hex }}
NOTARY_SCHEMA_ID_HEX={{ notary_schema_id_hex }}
NOTARY_CHAIN_ID={{ notary_chain_id | default('viper-pq-1') }}
NOTARY_CORS_ORIGIN={{ notary_cors_origin }}
RUST_LOG=viper_notary=info,tower_http=info
