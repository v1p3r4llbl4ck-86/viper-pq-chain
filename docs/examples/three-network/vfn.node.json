{
  "_comment": "VFN (Validator Full Node) — TASK-219 three-network role. Bridges validator-private and public-RPC networks. Listens on validator_listen (private) AND vfn_listen (intermediate). Does NOT bind public_listen. Holds NO signing keys.",
  "node_id": "vfn-1",
  "chain_id_hex": "<chain_id_hex from the published genesis>",
  "data_dir": "/var/lib/pqchain/vfn-1",
  "anchor_prev_hash_hex": "<32-byte hex from genesis>",
  "fee_params": {
    "base_fee": 100,
    "byte_fee": 10,
    "sigverify_fee_v_a": 60,
    "sigverify_fee_v_b": 600,
    "sigverify_fee_v_c": 6000,
    "exec_fee_per_gas": 1
  },
  "p2p_listen_addr": null,
  "api_listen_addr": "127.0.0.1:26657",
  "peers": [],
  "devnet": {
    "role": "sentry",
    "sync_interval_ms": 1000,
    "block_time_ms": 500,
    "epoch_duration": 60,
    "unbonding_period": 120,
    "validators": [],
    "snapshot_source": "<bootstrap full-node addr>"
  },
  "genesis_accounts": [],
  "rate_limit": {
    "max_requests_per_window": 1000,
    "window_secs": 60
  },
  "sender_budget": {
    "max_admits_per_window": 200,
    "window_secs": 60
  },
  "libp2p": {
    "_comment": "Three-network role: VFN. Inbound on validator_listen (from validators) + vfn_listen (from sentries). Outbound to validator_listen (peer VFNs).",
    "enable": true,
    "validator_listen": "/ip4/10.0.0.20/tcp/26656",
    "vfn_listen": "/ip4/10.0.0.20/tcp/26666",
    "public_listen": null,
    "bootstrap_peers": [
      "/ip4/10.0.0.20/tcp/26666/p2p/<peer-vfn-2 PeerId>",
      "/ip4/10.0.0.20/tcp/26666/p2p/<peer-vfn-3 PeerId>"
    ],
    "gossip_mesh_n": 6,
    "gossip_mesh_n_low": 3,
    "gossip_mesh_n_high": 12,
    "quic_enabled": true,
    "tcp_tls_fallback": true,
    "max_peers_per_asn": 3
  }
}
